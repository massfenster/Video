---
import Base from '../layouts/Base.astro';
import {AKTION, FIRMA, RECHNUNG, WHATSAPP, kwh} from '../data/firma';

const nf = new Intl.NumberFormat('de-DE', {maximumFractionDigits: 0});
const dec = (n: number) => n.toLocaleString('de-DE', {minimumFractionDigits: 1});
const alt = kwh(RECHNUNG.uAlt);
const neu = kwh(RECHNUNG.uNeu);
const pct = Math.round(((RECHNUNG.uAlt - RECHNUNG.uNeu) / RECHNUNG.uAlt) * 100);
const ersparnisEur = Math.round(((alt - neu) * RECHNUNG.preis) / 10) * 10;

const leistungen = [
  {
    icon: 'fenster',
    titel: 'Fenster nach Maß',
    text: `Moderne Fenster mit Uw ${dec(RECHNUNG.uNeu)} W/m²K – passgenau für Ihr Haus, robust und schön.`,
  },
  {icon: 'tuer', titel: 'Türen', text: 'Sichere und schöne Türen – passend zu Ihren Fenstern und Ihrem Haus.'},
  {icon: 'rollladen', titel: 'Rollläden', text: 'Alle Arten von Rollladenarbeiten, sorgfältig ausgeführt.'},
  {icon: 'insekt', titel: 'Insektenschutz', text: 'Ruhe vor Fliegen und Insekten – mit passenden Lösungen für Fenster und Türen.'},
  {icon: 'aufmass', titel: 'Aufmaß, Fertigung & Montage', text: 'Alles aus einer Hand: Wir messen auf, lassen fertigen und montieren fachgerecht.'},
  {icon: 'foerderung', titel: 'Energieberatung', text: 'Unser Energieberater unterstützt Sie dabei, BAFA- und KfW-Förderung zu nutzen.'},
];

const schritte = [
  {t: 'Anfrage', d: 'Per WhatsApp, Telefon oder E-Mail – kurz und unkompliziert.'},
  {t: 'Kostenloses Aufmaß', d: 'Wir kommen zu Ihnen, messen auf und beraten Sie vor Ort.'},
  {t: 'Unverbindliches Angebot', d: 'Sie erhalten ein klares Angebot – auf Wunsch mit Förderberatung.'},
  {t: 'Fachgerechte Montage', d: 'Wir bauen Ihre neuen Fenster sauber und zuverlässig ein.'},
];
---

<Base
  title="Fenster nach Maß in NRW | MassFensterNRW"
  description="Fenster, Türen & Rollläden nach Maß in NRW: kostenloses Aufmaß, unverbindliches Angebot und Energieberater für BAFA/KfW-Förderung. Jetzt anfragen!"
>
  <!-- Hero -->
  <section class="hero">
    <picture>
      <source media="(max-width: 760px)" srcset="/img/hero-mobile.webp" width="900" height="1400" />
      <img src="/img/hero-desktop.webp" alt="Modernes Einfamilienhaus am Winterabend mit warm beleuchteten Fenstern" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <div class="wrap hero-content">
      <p class="eyebrow">MassFensterNRW · Fenster · Türen · Rollläden</p>
      <h1>Fenster nach Maß<br /><span>in ganz NRW</span></h1>
      <p class="lead">Kostenloses Aufmaß, unverbindliches Angebot und Unterstützung durch unseren Energieberater bei der BAFA- und KfW-Förderung.</p>
      <div class="hero-actions">
        <a class="btn btn-cta" href={WHATSAPP} target="_blank" rel="noopener">Kostenloses Aufmaß anfragen →</a>
        <a class="btn btn-ghost" href={FIRMA.telefonHref}>Jetzt anrufen</a>
      </div>
      <ul class="trust">
        <li>Kostenloses Aufmaß</li>
        <li>Unverbindliches Angebot</li>
        <li>Energieberater für BAFA/KfW</li>
      </ul>
    </div>
  </section>

  <!-- Winter-Aktion -->
  {
    AKTION.aktiv && (
      <section class="aktion" data-bis={AKTION.bis} aria-labelledby="aktion-titel">
        <div class="wrap aktion-inner">
          <div>
            <p class="eyebrow dark">WINTER-AKTION</p>
            <h2 id="aktion-titel">
              <span class="big">{AKTION.rabatt}</span> Rabatt auf Fenster
            </h2>
            <p>Kostenloses Aufmaß &amp; unverbindliches Angebot.</p>
            <p class="small">{AKTION.bedingung}</p>
          </div>
          <a class="btn btn-dark" href={WHATSAPP} target="_blank" rel="noopener">Jetzt kostenloses Aufmaß anfragen →</a>
        </div>
      </section>
    )
  }

  <!-- Leistungen -->
  <section id="leistungen" class="section">
    <div class="wrap">
      <p class="eyebrow">Leistungen</p>
      <h2>Alles rund um Fenster, Türen und Rollläden</h2>
      <div class="cards">
        {
          leistungen.map((l) => (
            <article class="card">
              <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                {l.icon === 'fenster' && (
                  <g>
                    <rect x="9" y="7" width="30" height="34" rx="2" />
                    <line x1="24" y1="7" x2="24" y2="41" />
                    <line x1="9" y1="24" x2="39" y2="24" />
                  </g>
                )}
                {l.icon === 'tuer' && (
                  <g>
                    <rect x="13" y="5" width="22" height="38" rx="2" />
                    <rect x="17" y="10" width="14" height="10" rx="1" />
                    <circle cx="30" cy="27" r="1.6" />
                  </g>
                )}
                {l.icon === 'rollladen' && (
                  <g>
                    <rect x="9" y="7" width="30" height="34" rx="2" />
                    <line x1="9" y1="14" x2="39" y2="14" />
                    <line x1="9" y1="20" x2="39" y2="20" />
                    <line x1="9" y1="26" x2="39" y2="26" />
                    <line x1="9" y1="32" x2="39" y2="32" />
                  </g>
                )}
                {l.icon === 'insekt' && (
                  <g>
                    <rect x="9" y="7" width="30" height="34" rx="2" />
                    <path d="M9 16h30M9 24h30M9 32h30M17 7v34M24 7v34M31 7v34" stroke-width="1" />
                  </g>
                )}
                {l.icon === 'aufmass' && (
                  <g>
                    <rect x="4" y="18" width="40" height="12" rx="2" />
                    <path d="M11 18v5M17 18v7M23 18v5M29 18v7M35 18v5" />
                  </g>
                )}
                {l.icon === 'foerderung' && (
                  <g>
                    <path d="M24 6l16 8H8z" />
                    <path d="M12 18v16M20 18v16M28 18v16M36 18v16M7 40h34" />
                  </g>
                )}
              </svg>
              <h3>{l.titel}</h3>
              <p>{l.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Energie / Video -->
  <section class="section energie">
    <div class="wrap energie-grid">
      <div class="video-box">
        <video controls preload="none" playsinline poster="/media/waermebild-poster.jpg" width="540" height="960">
          <source src="/media/waermebild-de.mp4" type="video/mp4" />
        </video>
      </div>
      <div>
        <p class="eyebrow">Energie sparen</p>
        <h2>Was, wenn Sie Wärme sehen könnten?</h2>
        <p>
          Alte Fenster lassen im Winter viel Wärme entweichen. Neue Fenster halten sie im Haus – das spüren Sie bei den
          Heizkosten.
        </p>
        <div class="vergleich" role="table" aria-label="Beispielrechnung Wärmeverlust über die Fenster pro Winter">
          <div class="row head" role="row">
            <span role="columnheader">Wärmeverlust über die Fenster</span><span role="columnheader">pro Winter</span>
          </div>
          <div class="row" role="row">
            <span role="cell">Alte Fenster (Uw {dec(RECHNUNG.uAlt)})</span>
            <span role="cell" class="warm">≈ {nf.format(alt)} kWh</span>
          </div>
          <div class="row" role="row">
            <span role="cell">Neue Fenster (Uw {dec(RECHNUNG.uNeu)})</span>
            <span role="cell" class="cool">≈ {nf.format(neu)} kWh</span>
          </div>
          <div class="row total" role="row">
            <span role="cell">Weniger Wärmeverlust über die Fenster</span>
            <span role="cell"><strong>−{pct} %</strong> · ≈ {ersparnisEur} €</span>
          </div>
        </div>
        <p class="small">
          Beispielrechnung: {RECHNUNG.flaeche} m² Fensterfläche, Uw {dec(RECHNUNG.uAlt)} → {dec(RECHNUNG.uNeu)} W/m²K,
          {nf.format(RECHNUNG.gradstunden)} Heizgradstunden pro Jahr, {nf.format(RECHNUNG.preis * 100)} ct/kWh. Die Prozentangabe bezieht sich
          nur auf den Wärmeverlust über die Fenster, nicht auf die gesamten Heizkosten.
        </p>
      </div>
    </div>
  </section>

  <!-- Förderung -->
  <section id="foerderung" class="section light">
    <div class="wrap foerder-grid">
      <div>
        <p class="eyebrow dark">Förderung</p>
        <h2>Förderung nutzen – mit unserem Energieberater</h2>
        <p>
          Neue Fenster können über BAFA bzw. KfW gefördert werden. Unser Energieberater unterstützt Sie dabei, die passende
          Förderung zu nutzen. Sprechen Sie uns beim kostenlosen Aufmaß einfach darauf an.
        </p>
        <p class="small">Ob und in welcher Höhe eine Förderung möglich ist, hängt von den aktuellen Programmbedingungen und Ihrem Vorhaben ab.</p>
      </div>
      <a class="btn btn-cta" href={WHATSAPP} target="_blank" rel="noopener">Beratung anfragen →</a>
    </div>
  </section>

  <!-- Ablauf -->
  <section id="ablauf" class="section">
    <div class="wrap">
      <p class="eyebrow">So einfach geht’s</p>
      <h2>In vier Schritten zu neuen Fenstern</h2>
      <ol class="steps">
        {
          schritte.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Über uns -->
  <section class="section about">
    <div class="wrap about-inner">
      <blockquote>
        <p>„Fenster sind das Licht, die Freude und das lächelnde Gesicht eines Hauses. Wir fertigen und montieren für Sie die schönsten Fenster auf die robusteste Art und Weise.“</p>
        <footer>{FIRMA.inhaber} · Firmeninhaber</footer>
      </blockquote>
    </div>
  </section>

  <!-- Kontakt -->
  <section id="kontakt" class="section kontakt">
    <div class="wrap kontakt-grid">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2>Jetzt kostenloses Aufmaß anfragen</h2>
        <p>Schreiben Sie uns per WhatsApp oder rufen Sie an – wir melden uns schnell bei Ihnen.</p>
        <div class="kontakt-actions">
          <a class="btn btn-cta" href={WHATSAPP} target="_blank" rel="noopener">WhatsApp schreiben →</a>
          <a class="btn btn-ghost" href={FIRMA.telefonHref}>{FIRMA.telefon}</a>
          <a class="btn btn-ghost" href={`mailto:${FIRMA.email}?subject=${encodeURIComponent('Anfrage kostenloses Aufmaß')}`}>{FIRMA.email}</a>
        </div>
      </div>
      <dl class="facts">
        <dt>Adresse</dt>
        <dd>{FIRMA.strasse}, {FIRMA.plz} {FIRMA.ort}</dd>
        <dt>Erreichbarkeit</dt>
        <dd>{FIRMA.oeffnungszeiten}</dd>
        <dt>Einsatzgebiet</dt>
        <dd>Nordrhein-Westfalen</dd>
      </dl>
    </div>
  </section>
</Base>

<style>
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 10px;
  }
  .eyebrow.dark {
    color: var(--navy);
  }
  .small {
    font-size: 14px;
    color: var(--muted);
  }
  .section {
    padding: 80px 0;
  }
  .section h2 {
    font-size: clamp(28px, 4vw, 40px);
    max-width: 760px;
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero picture,
  .hero picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(16, 28, 48, 0.92) 0%, rgba(16, 28, 48, 0.6) 45%, rgba(16, 28, 48, 0) 70%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .hero h1 {
    font-size: clamp(40px, 6.4vw, 72px);
    max-width: 640px;
  }
  .hero h1 span {
    color: var(--cta);
  }
  .lead {
    font-size: clamp(17px, 2vw, 20px);
    max-width: 520px;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 24px;
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    color: var(--muted);
    font-size: 15px;
  }
  .trust li::before {
    content: '✓ ';
    color: var(--cta);
    font-weight: 700;
  }
  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      align-items: flex-start;
    }
    .hero::after {
      background: linear-gradient(180deg, rgba(16, 28, 48, 0.94) 0%, rgba(16, 28, 48, 0.75) 48%, rgba(16, 28, 48, 0.15) 70%, rgba(16, 28, 48, 0.6) 100%);
    }
    .hero-content {
      padding-top: 40px;
      padding-bottom: 300px;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }

  /* Aktion */
  .aktion {
    background: var(--amber);
    color: var(--navy);
    padding: 40px 0;
  }
  .aktion-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .aktion h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .aktion .big {
    font-size: clamp(54px, 8vw, 84px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .aktion p {
    margin-bottom: 4px;
  }
  .aktion .small {
    color: rgba(16, 28, 48, 0.75);
  }
  .btn-dark {
    background: var(--navy);
    color: var(--text);
  }
  .btn-dark:hover {
    background: var(--navy-3);
  }

  /* Leistungen */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-top: 36px;
  }
  .card {
    background: var(--navy-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .card h3 {
    font-size: 20px;
    margin-top: 14px;
  }
  .card p {
    color: var(--muted);
    margin: 0;
  }
  .icon {
    width: 48px;
    height: 48px;
    fill: none;
    stroke: var(--cta);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon circle {
    fill: var(--cta);
  }

  /* Energie */
  .energie {
    background: var(--navy-2);
  }
  .energie-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 56px;
    align-items: center;
  }
  .video-box video {
    width: 100%;
    border-radius: var(--radius);
    background: #000;
  }
  .vergleich {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 24px 0 14px;
  }
  .vergleich .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    border-top: 1px solid var(--line);
  }
  .vergleich .row.head {
    border-top: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vergleich .warm {
    color: var(--amber);
    font-weight: 700;
    white-space: nowrap;
  }
  .vergleich .cool {
    color: var(--cta);
    font-weight: 700;
    white-space: nowrap;
  }
  .vergleich .total {
    background: rgba(45, 175, 220, 0.12);
  }
  .vergleich .total strong {
    color: var(--cta);
  }
  @media (max-width: 860px) {
    .energie-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .video-box {
      max-width: 340px;
      margin: 0 auto;
    }
  }

  /* Förderung */
  .light {
    background: var(--paper);
    color: var(--ink);
  }
  .light p {
    color: var(--ink-muted);
  }
  .light .small {
    color: var(--ink-muted);
  }
  .foerder-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .foerder-grid > div {
    max-width: 720px;
  }

  /* Ablauf */
  .steps {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .steps li {
    border-top: 2px solid var(--line);
    padding-top: 18px;
  }
  .steps .num {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--cta);
    color: var(--navy);
    font-weight: 700;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }
  .steps h3 {
    font-size: 19px;
  }
  .steps p {
    color: var(--muted);
  }

  /* Über uns */
  .about {
    background: var(--navy-2);
  }
  .about blockquote {
    margin: 0 auto;
    max-width: 820px;
    text-align: center;
  }
  .about blockquote p {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    line-height: 1.35;
  }
  .about blockquote footer {
    color: var(--amber);
    letter-spacing: 0.08em;
  }

  /* Kontakt */
  .kontakt-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .kontakt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .facts {
    background: var(--navy-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 26px;
    margin: 0;
  }
  .facts dt {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd {
    margin: 2px 0 16px;
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .kontakt-grid {
      grid-template-columns: 1fr;
    }
    .kontakt-actions .btn {
      width: 100%;
    }
  }
</style>
