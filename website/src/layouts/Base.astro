---
import {AKTION, FIRMA, WHATSAPP} from '../data/firma';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}
const {title, description, path = '/', noindex = false} = Astro.props;
const canonical = new URL(path, FIRMA.web).toString();

// Strukturierte Daten für Google (nur belegte Angaben)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: FIRMA.name,
  url: FIRMA.web,
  telephone: FIRMA.telefon,
  email: FIRMA.email,
  image: `${FIRMA.web}/img/og.jpg`,
  logo: `${FIRMA.web}/img/logo.png`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: FIRMA.strasse,
    postalCode: FIRMA.plz,
    addressLocality: FIRMA.ort,
    addressCountry: 'DE',
  },
  areaServed: {'@type': 'State', name: 'Nordrhein-Westfalen'},
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  sameAs: [FIRMA.instagram, FIRMA.tiktok, FIRMA.facebook],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#101c30" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${FIRMA.web}/img/og.jpg`} />
    <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    {
      AKTION.aktiv && (
        <div class="aktion-bar" data-bis={AKTION.bis}>
          <span>
            ❄️ <strong>{AKTION.text}</strong> – gültig bis {AKTION.bisText}.
          </span>
          <a href={WHATSAPP} target="_blank" rel="noopener">
            Jetzt kostenloses Aufmaß anfragen →
          </a>
        </div>
      )
    }

    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="MassFensterNRW – Startseite">
          <img src="/img/logo.webp" alt="MassFensterNRW Logo" width="1068" height="726" />
        </a>
        <nav aria-label="Hauptmenü">
          <a href="/#leistungen">Leistungen</a>
          <a href="/#foerderung">Förderung</a>
          <a href="/#ablauf">Ablauf</a>
          <a href="/#kontakt">Kontakt</a>
        </nav>
        <a class="btn btn-cta header-cta" href={FIRMA.telefonHref}>{FIRMA.telefon}</a>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <img src="/img/logo.webp" alt="MassFensterNRW Logo" width="1068" height="726" class="footer-logo" />
          <p>Fenster, Türen, Rollläden und Insektenschutz nach Maß – in ganz NRW.</p>
        </div>
        <div>
          <h2>Kontakt</h2>
          <p>
            {FIRMA.name}<br />
            {FIRMA.strasse}<br />
            {FIRMA.plz} {FIRMA.ort}
          </p>
          <p>
            Tel. / WhatsApp: <a href={FIRMA.telefonHref}>{FIRMA.telefon}</a><br />
            E-Mail: <a href={`mailto:${FIRMA.email}`}>{FIRMA.email}</a><br />
            {FIRMA.oeffnungszeiten}
          </p>
        </div>
        <div>
          <h2>Folgen</h2>
          <p>
            <a href={FIRMA.instagram} target="_blank" rel="noopener">Instagram</a><br />
            <a href={FIRMA.tiktok} target="_blank" rel="noopener">TikTok</a><br />
            <a href={FIRMA.facebook} target="_blank" rel="noopener">Facebook</a>
          </p>
          <p>
            <a href="/impressum/">Impressum</a><br />
            <a href="/datenschutz/">Datenschutz</a>
          </p>
        </div>
      </div>
      <p class="wrap copy">© {new Date().getFullYear()} {FIRMA.name}</p>
    </footer>

    <!-- Mobile: feste Kontaktleiste -->
    <div class="mobile-bar" role="navigation" aria-label="Schnellkontakt">
      <a href={FIRMA.telefonHref} class="mb-call">Anrufen</a>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="mb-wa">WhatsApp</a>
    </div>

    <script is:inline>
      // Aktionsleiste nach Ablauf automatisch ausblenden
      document.querySelectorAll('[data-bis]').forEach(function (el) {
        if (new Date() > new Date(el.getAttribute('data-bis'))) el.remove();
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/inter-latin-500-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/inter-latin-700-normal.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/inter-latin-ext-500-normal.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Inter';
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/inter-latin-ext-700-normal.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  :root {
    --navy: #101c30;
    --navy-2: #172640;
    --navy-3: #22324c;
    --text: #edf2f5;
    --muted: #b7c2cf;
    --amber: #ffb547;
    --soft-yellow: #ffe19a;
    --cta: #2dafdc;
    --cta-hover: #4cc0e6;
    --line: rgba(237, 242, 245, 0.14);
    --paper: #f5f7f9;
    --ink: #101c30;
    --ink-muted: #4a5668;
    --radius: 18px;
    --wrap: 1160px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.6;
    background: var(--navy);
    color: var(--text);
  }
  img,
  video {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3 {
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 0.5em;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0 0 1em;
  }
  .wrap {
    width: 100%;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 20px;
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
    z-index: 100;
    background: #fff;
    color: var(--ink);
    padding: 8px 12px;
    border-radius: 8px;
  }
  :focus-visible {
    outline: 3px solid var(--cta);
    outline-offset: 3px;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-cta {
    background: var(--cta);
    color: var(--navy);
  }
  .btn-cta:hover {
    background: var(--cta-hover);
  }
  .btn-ghost {
    border: 2px solid var(--line);
    color: var(--text);
  }
  .btn-ghost:hover {
    border-color: var(--text);
  }

  /* Aktionsleiste */
  .aktion-bar {
    background: var(--amber);
    color: var(--navy);
    font-size: 15px;
    text-align: center;
    padding: 9px 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 16px;
  }
  .aktion-bar a {
    font-weight: 700;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(16, 28, 48, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    background: #fff;
    border-radius: 10px;
    padding: 5px 9px 3px;
    flex: none;
  }
  .brand img {
    width: 82px;
    height: auto;
  }
  .site-header nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }
  .site-header nav a {
    text-decoration: none;
    color: var(--muted);
  }
  .site-header nav a:hover {
    color: var(--text);
  }
  .header-cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .site-header nav {
      display: none;
    }
    .header-cta {
      margin-left: auto;
    }
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 56px 0 120px;
    color: var(--muted);
    font-size: 15px;
  }
  .site-footer h2 {
    color: var(--text);
    font-size: 16px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
  }
  .footer-logo {
    width: 120px;
    background: #fff;
    border-radius: 10px;
    padding: 6px 10px 4px;
    margin-bottom: 14px;
  }
  .copy {
    margin-top: 24px;
    font-size: 13px;
  }

  /* Mobile Kontaktleiste */
  .mobile-bar {
    display: none;
  }
  @media (max-width: 860px) {
    .mobile-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgba(16, 28, 48, 0.96);
      border-top: 1px solid var(--line);
    }
    .mobile-bar a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      border-radius: 14px;
      font-weight: 700;
      text-decoration: none;
    }
    .mb-call {
      border: 2px solid var(--line);
    }
    .mb-wa {
      background: var(--cta);
      color: var(--navy);
    }
  }

  /* Rechtstexte */
  .legal {
    background: var(--paper);
    color: var(--ink);
    padding: 56px 0 72px;
  }
  .legal .wrap {
    max-width: 800px;
  }
  .legal h1 {
    font-size: 36px;
  }
  .legal h2 {
    font-size: 21px;
    margin-top: 1.6em;
  }
  .legal p,
  .legal li {
    color: var(--ink-muted);
  }
  .legal a {
    color: var(--ink);
  }
</style>
