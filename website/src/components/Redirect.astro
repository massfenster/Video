---
// Weiterleitung für alte WordPress-Adressen (funktioniert auf jedem Webspace, auch ohne .htaccess)
interface Props {to: string}
const {to} = Astro.props;
const abs = new URL(to, 'https://massfensternrw.de').toString();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={abs} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Weiterleitung …</title>
  </head>
  <body>
    <p>Diese Seite ist umgezogen: <a href={to}>{abs}</a></p>
  </body>
</html>
